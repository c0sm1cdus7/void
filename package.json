{
  "name": "@c0sm1cdus7/void",
  "version": "0.0.0-n0",
  "private": true,
  "description": "VOID: capability modules and a preserved DESERT Notes web experience.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "web:build": "node scripts/build-web.ts",
    "dev": "node scripts/run-local.ts",
    "messages:write": "node node_modules/desert-sdk/scripts/messages.ts --write src",
    "messages:check": "node node_modules/desert-sdk/scripts/messages.ts --check src",
    "source:check": "node scripts/check-source.ts",
    "inspect": "node scripts/inspect.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 tests/*.test.ts",
    "test:web": "node --test --test-concurrency=1 --test-timeout=45000 tests/web/*.test.ts",
    "check": "npm run source:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "desert-sdk": "file:../desert"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
